    </EmbeddedResource>
    <EmbeddedResource Include="..\..\TestDLL\TestDllMain.Generated.Instruments.cs">
      <LogicalName>ManualCanDebug.TestDllMain.Generated.Instruments.cs</LogicalName>
    </EmbeddedResource>
    <Content Include="..\..\DLLs\*.dll" Exclude="..\..\DLLs\CSP_Base.dll;..\..\DLLs\CSP_Manage.dll;..\..\DLLs\Newtonsoft.Json.dll;..\..\DLLs\LogFileEx.dll;..\..\DLLs\CSP.TestDLL.dll;..\..\DLLs\Instruments.CAN.CANWrapper.dll;..\..\DLLs\Instruments.CAN.ICAN.dll;..\..\DLLs\Instruments.CAN.ZLG_CAN.dll;..\..\DLLs\zlgcan.dll">
