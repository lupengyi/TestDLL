      <Link>Config\ProductLocators\C95_Locator.xlsx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\测试资料_20260616(1)\附件六_《测试工序_FCT测试要求A0》\附件六_《测试工序_FCT测试要求A0》\C96\主驱资料\_Flywheel C96_Locator_V1.1_250807.xlsx">
      <Link>Config\ProductLocators\C96_Locator.xlsx</Link>
