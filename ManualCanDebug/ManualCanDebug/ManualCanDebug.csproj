      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\RuntimeDlls\Instruments.CAN.A2lReader.dll">
      <Link>Instruments.CAN.A2lReader.dll</Link>
