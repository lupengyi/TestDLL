    <Content Include="..\RuntimeDlls\Instruments.CAN.ZLG_CAN.dll">
      <Link>Instruments.CAN.ZLG_CAN.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\RuntimeDlls\zlgcan.dll">
