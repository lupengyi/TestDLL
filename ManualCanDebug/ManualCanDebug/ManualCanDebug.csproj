    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="CSP_Base">
      <HintPath>..\..\DLLs\CSP_Base.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="CSP_Manage">
      <HintPath>..\..\DLLs\CSP_Manage.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\DLLs\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <ProjectReference Include="..\ManualCanDebug.Core\ManualCanDebug.Core.csproj">
      <Project>{DBA7B77D-7C57-4C80-9DE7-7A4E8F1E7201}</Project>
      <Name>ManualCanDebug.Core</Name>
