  <ItemGroup>
    <PackageReference Include="NodeNetwork" Version="6.0.0" />
  </ItemGroup>
  <Target Name="CopyLegacyKernelFiles" AfterTargets="Build">
    <Copy SourceFiles="@(LegacyKernelFile)" DestinationFiles="@(LegacyKernelFile->'$(OutDir)LegacyRuntime\kerneldlls\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyCanRuntimeToLegacy" AfterTargets="Build">
    <ItemGroup>
      <LegacyCanRuntime Include="..\RuntimeDlls\Instruments.CAN.CANWrapper.dll;..\RuntimeDlls\Instruments.CAN.ICAN.dll;..\RuntimeDlls\Instruments.CAN.ZLG_CAN.dll;..\RuntimeDlls\zlgcan.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(LegacyCanRuntime)" DestinationFolder="$(OutDir)LegacyRuntime" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\RuntimeDlls\kerneldlls\CANFDNET.dll" DestinationFolder="$(OutDir)LegacyRuntime\kerneldlls" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyExtendedTestDll" AfterTargets="Build">
    <PropertyGroup>
      <_ExtendedTestDllPath Condition="Exists('$(OutDir)CSP.TestDLL.dll')">$(OutDir)CSP.TestDLL.dll</_ExtendedTestDllPath>
      <_ExtendedTestDllPath Condition="'$(_ExtendedTestDllPath)' == ''">$(MSBuildProjectDirectory)\..\..\CSP.TestDLL.Extension\bin\$(Configuration)\CSP.TestDLL.dll</_ExtendedTestDllPath>
      <_An23600ePath>$(MSBuildProjectDirectory)\..\..\DLLs\Instruments.Load.AN23600E.dll</_An23600ePath>
    </PropertyGroup>
    <Copy SourceFiles="$(_ExtendedTestDllPath)" DestinationFiles="$(OutDir)LegacyRuntime\CSP.TestDLL.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_An23600ePath)" DestinationFiles="$(OutDir)LegacyRuntime\Instruments.Load.AN23600E.dll" SkipUnchangedFiles="true" Condition="Exists('$(_An23600ePath)')" />
  </Target>
</Project>
