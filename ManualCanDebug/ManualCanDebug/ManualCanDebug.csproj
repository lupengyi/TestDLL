      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\DLLs\LogFileEx.dll">
      <Link>LogFileEx.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <LegacyKernelFile Include="..\..\DLLs\kerneldlls\**\*" Exclude="..\..\DLLs\kerneldlls\CANFDNET.dll" />
    <Content Include="..\..\Config\*.*" Exclude="..\..\Config\Flywheel_900A_Z405.dbc;..\..\Config\Resolver.dbc">
