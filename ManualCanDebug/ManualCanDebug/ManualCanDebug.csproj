    <Content Include="..\RuntimeDlls\Instruments.CAN.CSVReader.dll">
      <Link>Instruments.CAN.CSVReader.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\DLLs\kerneldlls\**\*" Exclude="..\..\DLLs\kerneldlls\CANFDNET.dll">
      <Link>kerneldlls\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\RuntimeDlls\kerneldlls\CANFDNET.dll">
      <Link>kerneldlls\CANFDNET.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
